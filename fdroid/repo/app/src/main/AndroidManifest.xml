<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core SMS permissions: send, receive, and read messages. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />

    <!-- Read contacts so conversations can show contact names. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Wake lock to finish processing incoming SMS quickly. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notification permission (Android 13+) for new message alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only devices that can place SMS calls really need this app. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".ZenMsgApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZenMsg"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZenMsg"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives incoming SMS. exported+permission so only the system can broadcast to it. -->
        <receiver
            android:name=".messaging.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Tracks delivery status of sent messages. -->
        <receiver
            android:name=".messaging.SmsDeliveryReceiver"
            android:exported="false" />

        <!-- Boot completed: reschedule any pending work. -->
        <receiver
            android:name=".messaging.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

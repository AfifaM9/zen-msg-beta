<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. The real colours come from MaterialTheme in Compose; this
         XML theme just provides a window background and a no-action-bar parent
         so the launch screen doesn't flash the default purple. -->
    <style name="Theme.ZenMsg" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zen_background</item>
        <item name="android:statusBarColor">@color/zen_background</item>
    </style>

    <color name="zen_background">#FFF7F9F8</color>
    <color name="zen_background_dark">#FF0E1514</color>
</resources>
